# 复制为 scripts/deploy.conf(已被 .gitignore 排除)并填入你的站点信息。
# 也可以用环境变量同名覆盖(CARAOK_SERVER 等)。
CARAOK_SERVER=root@your-vps
CARAOK_DOMAIN=audio.your-domain.example
CARAOK_ORIGIN_IP=203.0.113.10
CARAOK_APP_DIR=/opt/caraok
CARAOK_BIND=172.17.0.1:8091
CARAOK_NGINX_CONTAINER=nginx-tcp-proxy
CARAOK_NGINX_CONF=/etc/nginx/nginx.conf
