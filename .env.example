# Replace with your domain; its DNS A/AAAA record must point to this VPS.
DOMAIN=audio.example.com

# Generate both values with: openssl rand -hex 32
ACCESS_TOKEN=CHANGE_ME
APP_SECRET_KEY=CHANGE_ME

# Exact hostnames only, comma separated. Must include DOMAIN itself: downloaded
# audio is published as https://DOMAIN/media/<file> and would be rejected by the
# allowlist (502) otherwise. Add every remote audio host and its CDN redirects.
AUDIO_ALLOWED_HOSTS=audio.example.com,cdn.example.com

# Keep true behind Caddy HTTPS. Use false only for localhost development.
COOKIE_SECURE=true
SESSION_TTL_SECONDS=2592000
TRACKS_CONFIG=/app/config/tracks.yaml

# Login rate limiting keys on the client address. Enable this ONLY when a
# reverse proxy in front of the API overwrites X-Client-IP (or appends the
# client to X-Forwarded-For) on every request — scripts/deploy.sh does this via
# nginx. Left false, all clients share one throttle bucket: safe, but one
# attacker can lock out sign-in for everyone.
TRUST_PROXY_CLIENT_IP=false

# SQLite catalog (runtime state; tracks.yaml is imported once on first boot).
# Leave as shown unless you mount the data volume elsewhere.
DB_PATH=/app/data/caraok.db

# Local media base. Downloaded tracks are referenced as <base>/<file> and served
# ONLY through the authenticated /api/v1/stream/{id} route — the static
# /media/* path returns 404 by design. The host must also appear in
# AUDIO_ALLOWED_HOSTS above, otherwise startup validation rejects those tracks.
PUBLIC_MEDIA_BASE=https://your.domain/media

# ── Admin download pipeline (optional; all four are needed together) ──────────
# Without YTDLP_COOKIES_HOST the download API stays disabled (audio playback is
# unaffected). Every value must be present for the pipeline to work end-to-end.
YTDLP_COOKIES_HOST=cookies.txt  # 示例路径;改成你导出 cookies 的位置
# WARP/SOCKS egress for yt-dlp (use the gateway of THIS compose network).
YTDLP_PROXY=socks5h://172.20.0.1:40001
# bgutil PO token provider endpoint.
YTDLP_POT_URL=http://172.20.0.1:4416
